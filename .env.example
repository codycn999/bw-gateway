# Copy to /etc/bw-gateway/env (root:root, 600) and fill in real values.
# systemd passes it to the service via EnvironmentFile. Never commit the real file.

# Machine account access token from Bitwarden cloud (vault.bitwarden.com):
# Secrets Manager -> Machine accounts -> Access tokens -> Create access token.
BWS_ACCESS_TOKEN=PASTE_MACHINE_ACCOUNT_TOKEN_HERE

# Organization ID (UUID) from the Bitwarden web vault organization URL.
BWS_ORGANIZATION_ID=PASTE_ORGANIZATION_ID_HERE

# Bitwarden cloud endpoints (change only for self-hosted Bitwarden).
BWS_SERVER_URL=https://vault.bitwarden.com

# --- Agent keys: one line per agent -----------------------------------------
# GATEWAY_KEY_<NAME>=<sha256 of the key>:<allowed>,<allowed>,...
# <allowed> is a secret name, a glob (OPENAI_*), a secret uuid, project:<project-uuid>,
# or by-uuid (any secret/project the agent is given the exact uuid of; nothing listed).
# Create lines with: python3 scripts/new-agent-key.py <name> '<allowed>'
# Only the hash lives here. Restart the service after any change.
# GATEWAY_KEY_CODY=<64 hex chars>:OPENAI_*,GITHUB_TOKEN

# Old shared key: full access to every secret. Remove once every agent has
# its own GATEWAY_KEY_<NAME>.
# GATEWAY_API_KEY=

# --- Optional tuning (defaults shown) ----------------------------------------
# GATEWAY_RATE_PER_MIN=60          # requests per key per minute
# GATEWAY_AUTH_FAIL_LIMIT=10       # failed auths from one IP ...
# GATEWAY_AUTH_FAIL_WINDOW=600     # ... within this many seconds ...
# GATEWAY_AUTH_BLOCK_SECONDS=900   # ... block that IP for this long
# GATEWAY_INDEX_TTL=60             # seconds to cache the secret name list
# GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1   # who may set X-Forwarded-For
# GATEWAY_ENABLE_DOCS=0            # 1 = serve /docs and /openapi.json
