# Copy to .env and fill in real values. Never commit the real .env.
# Machine account access token from Bitwarden cloud (vault.bitwarden.com):
# Secrets Manager -> Machine accounts -> Access tokens -> Create access token.
# Shown only once; paste the full token (starts with "0.").
BWS_ACCESS_TOKEN=PASTE_MACHINE_ACCOUNT_TOKEN_HERE

# Organization ID (UUID) from the Bitwarden web vault organization URL.
BWS_ORGANIZATION_ID=PASTE_ORGANIZATION_ID_HERE

# Ordinary API key that agents present as X-Gateway-Key to call this gateway.
# Generate one, e.g.: openssl rand -hex 32
# Changing it requires restarting the service (read once at startup).
GATEWAY_API_KEY=PASTE_GATEWAY_API_KEY_HERE

# Bitwarden cloud endpoints (change only for self-hosted Bitwarden).
BWS_SERVER_URL=https://vault.bitwarden.com
