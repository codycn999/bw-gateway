# HTTPS entry for bw-gateway. The gateway itself keeps listening on
# 127.0.0.1:8080 only; Caddy terminates TLS and forwards.
#
# Replace the host name. Without your own domain, use <external-ip>.sslip.io
# (e.g. 34.123.45.67.sslip.io); Caddy gets a Let's Encrypt cert automatically.
# Needs: GCP firewall allows tcp:80 (ACME challenge) and tcp:443.

34.0.0.1.sslip.io {
	# Only the API is exposed; everything else is 404.
	@api path /health /v1/*
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}

	request_body {
		max_size 64KB
	}
}
